<Page
    x:Class="UniSky.Pages.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UniSky.Pages"
    xmlns:controls="using:UniSky.Controls"
    xmlns:extensions="using:UniSky.Extensions"
    xmlns:notifications="using:UniSky.ViewModels.Notifications"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mux="using:Microsoft.UI.Xaml.Controls"
    xmlns:w1709="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsApiContractPresent(Windows.Foundation.UniversalApiContract, 5)"
    xmlns:w1803="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsApiContractPresent(Windows.Foundation.UniversalApiContract, 6)"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    w1803:KeyboardAcceleratorPlacementMode="Hidden">

    <Page.Resources>
        <NotificationTemplates xmlns="using:UniSky.Templates"/>
    </Page.Resources>

    <w1709:Page.KeyboardAccelerators>
        <w1709:KeyboardAccelerator x:Name="RefreshAccelerator"
                                   Key="F5"
                                   Invoked="RefreshAccelerator_Invoked"/>
    </w1709:Page.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarPadding" Height="0"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBackground"
                Grid.RowSpan="2"
                MaxWidth="600"
                Background="{ThemeResource GenericPageHeaderBackgroundBrush}"
                BorderBrush="{ThemeResource SystemControlRevealSeparatorBrush}"
                extensions:Hairline.BorderThickness="1,0,1,1"/>

        <Border Grid.Row="1"
                Padding="{ThemeResource GenericPageHeaderMargin}"
                MaxWidth="600">
            <TextBlock x:Uid="NotificationsPageTitleBlock"
                       Margin="12,4,12,12"
                       Text="NOTIFICATIONS"
                       Style="{ThemeResource BaseTextBlockStyle}"/>
        </Border>

        <mux:RefreshContainer Grid.Row="2"
                              Canvas.ZIndex="-1"
                              RefreshRequested="OnRefreshRequested">
            <ListView Style="{StaticResource FeedListViewStyle}"
                      x:Name="RootList"
                      ItemsSource="{x:Bind ViewModel.Notifications, Mode=OneWay}"
                      ItemTemplateSelector="{StaticResource NotificationItemTemplateSelector}"
                      Loaded="RootList_Loaded">
                <ListView.FooterTemplate>
                    <DataTemplate>
                        <Grid HorizontalAlignment="Stretch">
                            <ProgressRing Width="32"
                                          Height="32"
                                          Margin="16"
                                          IsActive="{Binding IsLoading}"
                                          HorizontalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.FooterTemplate>
            </ListView>
        </mux:RefreshContainer>

        <Grid x:Name="NoItemsGrid"
              x:Load="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
              Grid.Row="2"
              MaxWidth="600"
              Margin="24,80,24,0"
              VerticalAlignment="Top"
              HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xEA8F;"
                       FontSize="48"
                       FontFamily="{ThemeResource SymbolThemeFontFamily}"
                       VerticalAlignment="Center"/>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" Grid.Column="1">
                <TextBlock x:Uid="NotificationsPageNoItemsTitle"
                           TextWrapping="Wrap"
                           Text="Nothing here yet!"
                           Style="{ThemeResource TitleTextBlockStyle}"/>
                <TextBlock x:Uid="NotificationsPageNoItemsSubtitle"
                           TextWrapping="Wrap"
                           Text="Likes, replies and follows will show up here."
                           Style="{ThemeResource BodyTextBlockStyle}"/>
            </StackPanel>
        </Grid>

        <controls:LoadErrorControl x:Name="LoadError"
                                   x:Uid="NotificationsLoadError"
                                   Grid.Row="2"
                                   Title="Failed to load notifications!"
                                   Error="{x:Bind ViewModel.Error, Mode=OneWay}"
                                   RetryCommand="{x:Bind ViewModel.RefreshCommand}"/>

        <ProgressBar Grid.Row="2"
                     MaxWidth="600"
                     VerticalAlignment="Top"
                     IsIndeterminate="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                     Background="Transparent"/>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Small">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>

                    <VisualState.Setters>
                        <Setter Target="HeaderBackground.(extensions:Hairline.BorderThickness)" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="621" />
                    </VisualState.StateTriggers>

                    <VisualState.Setters>
                        <Setter Target="HeaderBackground.(extensions:Hairline.BorderThickness)" Value="1,0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
